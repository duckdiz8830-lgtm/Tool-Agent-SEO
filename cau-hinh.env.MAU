# ============================================================
#  DOI TEN FILE NAY THANH:  cau-hinh.env  roi dien vao sau dau =
#  File cau-hinh.env chi nam tren may ban.
#  KHONG gui cho ai, KHONG nen chung khi gui phan mem di.
# ============================================================
#
#  Ver 5.7 — VIET LAI TOAN BO.
#  Ban truoc cua file nay day SAI TEN BIEN: no huong dan dien
#  WP_SITE1_URL / WP_SITE1_USER / WP_SITE1_APP_PW, nhung KHONG CO
#  DONG CODE NAO doc 3 bien do nua (da doi sang WP_WEBSITE_* tu Ver 3).
#  Ai cai may moi theo file mau cu se KHONG KET NOI DUOC WordPress
#  va khong hieu tai sao. Ngoai ra con thieu 15 bien ma code that su
#  co doc. Nay liet ke DU, doi chieu truc tiep voi source.
#
#  Hau het cac bien duoi day KHONG CAN dien tay — bam trong tab
#  "Cau hinh" cua phan mem, tool tu ghi vao cau-hinh.env. Chi 2 nhom
#  BAT BUOC phai co: GOOGLE_API_KEY va WP_WEBSITE_*.
# ============================================================


# ============================================================
#  1. BAT BUOC — AI SINH NOI DUNG
# ============================================================

# gemini = Google AI Studio, MIEN PHI, khong can the tin dung
# claude = Claude API, tra tien theo token
NHA_CUNG_CAP=gemini

# Lay o: https://aistudio.google.com  >  Get API key
GOOGLE_API_KEY=

# Ten model. Google hay doi ten. Bam "Do model chay duoc" o tab Cau hinh
# de biet key cua minh dung duoc cai nao. Tranh model co chu "gemma".
MODEL_GEMINI=gemini-3.6-flash

# --- Du phong khi key chinh het quota (Ver 4.7) ---
# Quota Gemini free tier tinh THEO GOOGLE CLOUD PROJECT, khong phai theo key.
# Muon tang han muc that thi key du phong phai thuoc PROJECT KHAC.
# Nhieu gia tri thi ngan cach bang dau phay.
# Thu tu thu: doi MODEL truoc (khong ton quota key khac), roi moi doi KEY.
GOOGLE_API_KEY_DU_PHONG=
MODEL_GEMINI_DU_PHONG=

# --- Chi dien neu NHA_CUNG_CAP=claude ---
# LUU Y (kiem chung 22/08/2026): chuoi "ANTHROPIC_API_KEY" KHONG xuat hien
# trong bat ky file .py nao cua repo. Duong claude goi anthropic.Anthropic()
# khong tham so (autopost.py:589) — thu vien tu doc bien moi truong
# ANTHROPIC_API_KEY cua HE DIEU HANH. Nghia la dat no trong cau-hinh.env
# CO THE khong an, tuy cach tool nap env. Chua kiem chung duoc dau la dung.
# Duong gemini KHONG can bien nay. De nguyen comment cho toi khi co ai
# that su chay che do claude va xac nhan.
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_CLAUDE=claude-haiku-4-5


# ============================================================
#  2. BAT BUOC — WEBSITE WORDPRESS
# ============================================================
# LUU Y: day la WP_WEBSITE_*, KHONG phai WP_SITE1_*.
# Bam tab "Cau hinh > Website WordPress" trong phan mem de tool tu ghi.

WP_WEBSITE_TEN=
WP_WEBSITE_URL=https://tenmien-cua-ban.vn
WP_WEBSITE_USER=admin

# KHONG phai mat khau dang nhap. Day la Application Password:
#   WordPress > Users > Profile > keo xuong cuoi > Application Passwords
#   go ten bat ky vi du "autopost" > Add New
#   no hien ra chuoi dang: abcd EFGH 1234 ijkl MNOP 5678
#   copy NGUYEN CA KHOANG TRANG, dan vao day (code co y khong strip)
WP_WEBSITE_APP_PW=

# post        = dang thanh bai viet WordPress (/wp/v2/posts)
# woo_product = dang thanh san pham WooCommerce (/wc/v3/products)
#               Can tai khoan co quyen manage_woocommerce.
# Mac dinh: post
WP_WEBSITE_CHE_DO=post

# Hotline in len anh + hien trong bai. De trong thi lay WATERMARK_PHONE.
WP_WEBSITE_HOTLINE=


# ============================================================
#  3. TUY CHON — WATERMARK ANH
# ============================================================
# Mac dinh code da BAT du cac dong nay chua co trong cau-hinh.env.
# Watermark CHI ap len ban upload, KHONG sua anh goc.

WATERMARK_ENABLED=1

# De trong -> tu dung domain + WATERMARK_PHONE. Ho tro {domain} va {phone}.
WATERMARK_TEXT=

# Hotline in duoi domain. Khai mot lan cho website hien tai.
WATERMARK_PHONE=

# Kieu watermark (Ver 5.5). Gia tri hop le, sai thi tu ve 'ket_hop':
#   goc      = hop den 1 goc (hanh vi cu truoc 5.5)
#   cheo     = lap cheo mo toan anh, chong crop
#   thanh    = thanh chan trang, doc duoc o thumbnail
#   ket_hop  = cheo + thanh  (MAC DINH)
WATERMARK_STYLE=ket_hop

# Do dam cua lop lap cheo, 0..120. Mac dinh 52.
WATERMARK_TILE_ALPHA=52

# 35..220 (alpha tren thang 255). Mac dinh 82 = nhe.
WATERMARK_OPACITY=82

# bottom-right | bottom-left | top-right | top-left
WATERMARK_POSITION=bottom-right

# Ty le co chu theo chieu rong anh: 0.018..0.080
WATERMARK_SCALE=0.026


# ============================================================
#  4. TUY CHON — HIEN THI BAI VIET
# ============================================================
# Cac cong tac 0/1. Deu co nut bat/tat trong tab Cau hinh.

# 1 = bo o anh placeholder khoi bai. Mac dinh 0.
# (Tu Ver 4.4 o anh trong LUON bi an, cong tac nay chi con cho bai cu.)
BO_ANH_PLACEHOLDER=0

# 1 = bo khoi CTA cuoi bai. Mac dinh 0.
BO_CTA_CUOI=0

# 1 = xuat CSS ra file rieng va dung class thay vi style inline.
# Nho: WordPress kses XOA the <style> nhung GIU text ben trong,
# nen neu bat cai nay thi PHAI nap file CSS qua WPCode/theme.
# Mac dinh 0 (style inline, an toan nhat).
CSS_CLASS_MODE=0

# 1 = hien chip thong so nhanh o khoi hero dau bai. Mac dinh 0.
HERO_HIEN_CHIP_QUICK=0

# 1 = dung cong thuc slug NGAN. Mac dinh 0.
# Doi cai nay SAU KHI site da index = doi URL hang loat. Can nhac ky.
SLUG_NGAN=0

# 1 = dung bo dung bai giao dien 2.5. Mac dinh 0.
GIAO_DIEN_2_5=0

# 1 = sinh JSON-LD schema. Mac dinh 1 (bat).
# Schema di qua meta key rieng (_snl_schema_jsonld), KHONG nhung vao HTML.
SONEALEO_SCHEMA=1


# ============================================================
#  4b. TUY CHON — CONG CHAT LUONG ANH (Ver 5.7)
# ============================================================

# Nguong CANH NGAN toi thieu (px) de mot anh duoc phep upload.
# Anh duoi nguong bi BO QUA hoan toan, khong upload, o anh de trong.
# Tinh theo CANH NGAN: anh 3000x500 van bi chan vi canh ngan chi 500.
#
# Truoc Ver 5.7 nguong nay CHI chay khi tu nho bam LOC-KHO-ANH.bat.
# Tu 5.7 no nam ngay tren duong upload that, khong bo sot duoc nua.
#
#   de trong  = dung mac dinh 800
#   0         = TAT hoan toan cong anh (chi dung khi biet ro dang lam gi)
#   so khac   = nguong tuy chon, vi du 1000 neu muon chat hon
#
# Gia tri rac hoac so am -> tu quay ve 800.
ANH_CANH_NGAN_TOI_THIEU=800


# ============================================================
#  5. TUY CHON — DUONG DAN & DICH VU NGOAI
# ============================================================

# Serper.dev — tra cuu SERP. De trong thi tinh nang do tat.
SERPER_API_KEY=

# Thu muc kho anh san pham. De trong thi dung mac dinh cua tool.
# THU_MUC_ANH=D:\Anh-San-Pham

# --- Duong dan du lieu ---
# Mac dinh MOI FILE DU LIEU SONG nam o:  %APPDATA%\SONEALEO\
# KHONG nam trong thu muc code. Sao luu la sao luu thu muc do.
#
# SONEALEO_DATA_DIR co code doc that (thu_muc_du_lieu.py).
# SONEALEO_DB_PATH / SONEALEO_ENV_PATH: kiem chung 22/08/2026, hai bien nay
#   CHI xuat hien trong tests/test_v38_gate7_woo_schema.py, KHONG co code
#   san xuat nao doc. Dat trong cau-hinh.env se KHONG co tac dung. Ghi ra
#   day de khoi ai di tim, khong phai de dien.
# SONEALEO_DATA_DIR=


# ============================================================
#  KHO ANH GOC CUA CONG TY  (Ver 6.3)
# ============================================================

# Thu muc chua TOAN BO anh chua phan loai cua cong ty — thu muc co cac
# folder con dat theo LOAI + HANG, vi du:
#     BIEN AP TU EMIC / DAU CAP 3M / CHI ONG ABB / CAP CADIVI
#
# Dung cho nut "Kho anh cong ty" o tab Anh. Chi TRA CUU, khong sua gi
# trong thu muc nay.
#
# KHONG CAN dien tay: lan dau bam nut, tool se hoi chon thu muc roi tu ghi.
KHO_ANH_NGUON=
